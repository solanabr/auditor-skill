{
  "name": "f08-agent-wildcard",
  "triggers": [
    "issues"
  ],
  "permissions": [
    "contents: read",
    "issues: write"
  ],
  "jobs": [
    {
      "id": "triage",
      "line": 10,
      "permissions": [],
      "steps": [
        {
          "line": 13,
          "uses": "actions/checkout@08c6903cd8c0fde910a37f88322edcfb5dd907a8",
          "with": [],
          "env": []
        },
        {
          "line": 14,
          "uses": "anthropics/claude-code-action@v1",
          "with": [
            {
              "key": "anthropic_api_key",
              "value": "${{ secrets.ANTHROPIC_API_KEY }}"
            },
            {
              "key": "github_token",
              "value": "${{ secrets.GITHUB_TOKEN }}"
            },
            {
              "key": "allowed_non_write_users",
              "value": "*"
            },
            {
              "key": "claude_args",
              "value": "--allowedTools \"Bash,Read,Write,Edit\""
            },
            {
              "key": "prompt",
              "value": "Triage this issue. Title: ${{ github.event.issue.title }}"
            }
          ],
          "env": []
        }
      ]
    }
  ],
  "unknown": []
}
