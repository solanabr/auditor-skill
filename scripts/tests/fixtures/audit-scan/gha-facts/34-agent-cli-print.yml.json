{
  "name": "f34-agent-cli-print",
  "triggers": [
    "pull_request_target"
  ],
  "permissions": [
    "contents: read",
    "pull-requests: write"
  ],
  "jobs": [
    {
      "id": "summarize",
      "line": 10,
      "permissions": [],
      "steps": [
        {
          "line": 13,
          "run": "claude --print \"Summarize the change in this pull request\"",
          "with": [],
          "env": [
            {
              "key": "ANTHROPIC_API_KEY",
              "value": "${{ secrets.ANTHROPIC_API_KEY }}"
            }
          ]
        }
      ]
    }
  ],
  "unknown": []
}
