{
  "name": "f07-prt-head-checkout",
  "triggers": [
    "pull_request_target"
  ],
  "permissions": [
    "contents: write"
  ],
  "jobs": [
    {
      "id": "build",
      "line": 9,
      "permissions": [],
      "steps": [
        {
          "line": 12,
          "uses": "actions/checkout@08c6903cd8c0fde910a37f88322edcfb5dd907a8",
          "with": [
            {
              "key": "ref",
              "value": "${{ github.event.pull_request.head.sha }}"
            }
          ],
          "env": []
        },
        {
          "line": 15,
          "run": "echo \"PR title is ${{ github.event.pull_request.title }}\"",
          "with": [],
          "env": []
        },
        {
          "line": 17,
          "run": "echo \"PR_TITLE=$TITLE\" >> \"$GITHUB_ENV\"",
          "with": [],
          "env": [
            {
              "key": "TITLE",
              "value": "${{ github.event.pull_request.title }}"
            }
          ]
        },
        {
          "line": 20,
          "run": "anchor build && solana-verify build",
          "with": [],
          "env": [
            {
              "key": "ANCHOR_WALLET",
              "value": "${{ secrets.DEPLOY_KEYPAIR }}"
            }
          ]
        }
      ]
    }
  ],
  "unknown": []
}
