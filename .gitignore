# Assistant instructions, memory, plans and tool state from a contributor's own setup
.claude/
CLAUDE.md
CLAUDE.local.md
.mcp.json
.memsearch/
.cursor/
.agents/
.playwright-mcp/
/docs/superpowers/
/docs/plans/

# A maintainer's local knowledge-base checkout; never part of a release
solana-security-kb/

# Environment files: they hold secrets, and the release ships none
.env
.env.*

# Local worktrees
.wt/
.worktrees/

# What the auditor writes when it runs: run folders and the findings store (each also ignores itself)
audit_*/
incident_*/
.audit-memory/

# Build outputs, anchored because scripts/tests/fixtures/target/ is a tracked folder
/tools/**/target/
/templates/**/target/

# Python and Node caches
__pycache__/
*.py[cod]
.venv/
node_modules/

# Temporary files: here-documents an older bash leaves in the working directory, patch leftovers
sh-thd-*
*.orig
*.rej
*.tmp

# OS and editor files
.DS_Store
._*
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp
*.swo
*~
